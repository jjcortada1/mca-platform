# ─────────────────────────────────────────────
# Database (required)
# ─────────────────────────────────────────────
# Neon Postgres connection string (https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# ─────────────────────────────────────────────
# Auth (required)
# ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─────────────────────────────────────────────
# Encryption (required)
# ─────────────────────────────────────────────
# Used to encrypt SMTP credentials at rest. 64-char hex (32 bytes).
# Generate: openssl rand -hex 32
# WARNING: Do NOT change after data is saved — saved SMTP creds become unrecoverable.
ENCRYPTION_KEY=

# ─────────────────────────────────────────────
# Seed: master admin (required for `npm run db:seed`)
# ─────────────────────────────────────────────
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# ─────────────────────────────────────────────
# Seed: optional first company
# Set these to provision a company + its admin during `db:seed`.
# Leave blank to create companies via the master admin UI instead.
# ─────────────────────────────────────────────
SEED_COMPANY_NAME=Cortada Capital Group
SEED_COMPANY_SLUG=cortada
SEED_COMPANY_ADMIN_EMAIL=
SEED_COMPANY_ADMIN_PASSWORD=

# ─────────────────────────────────────────────
# Seed: full test workflow
# Set SEED_TEST_DATA=true to populate the company with:
#   - 1 test rep (credentials below)
#   - 5 sample funders (cloned from master defaults)
#   - 1 in-flight deal already submitted to 2 funders (1 approved, 1 pending)
#   - 1 deal still in shopping state
#   - 1 funded board entry
#   - 1 info entry
# Lets you test the full workflow immediately after install.
# ─────────────────────────────────────────────
SEED_TEST_DATA=false
SEED_TEST_REP_EMAIL=rep@test.com
SEED_TEST_REP_PASSWORD=TestRep123!

# ─────────────────────────────────────────────
# System SMTP (optional)
# Used ONLY for password-reset emails. Deal-submission emails use either the
# company SMTP (shared mode) or each rep's SMTP (per-rep mode).
# ─────────────────────────────────────────────
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_SMTP_FROM=
