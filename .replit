modules = ["nodejs-20", "postgresql-16"]

run = ["sh", "-c", "npm run setup && npm run dev"]

[deployment]
build = ["sh", "-c", "npm install --legacy-peer-deps && npm run build"]
run = ["sh", "-c", "npm run setup && npm start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run setup && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

