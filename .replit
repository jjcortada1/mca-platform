modules = ["nodejs-20", "postgresql-16"]

run = ["sh", "-c", "npm run setup && npm run dev"]

[deployment]
build = ["sh", "-c", "npm install --legacy-peer-deps && npm run build"]
run = ["sh", "-c", "npm run setup && npm start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run setup && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

# DATABASE_URL is intentionally NOT stored here. Keep it in Replit → Secrets
# (Tools → Secrets) so the database connection is never committed to the repo
# and never overwritten by a code upload. A leaked connection string can let
# anyone read/delete the database, and an overwritten one points the app at the
# wrong database (which looks exactly like "all my data disappeared").
